{
  "name": "static-site",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "node build.js",
    "dev": "concurrently -k \"nodemon -q -w content -w views -w public -e md,ejs,css,js,png -x 'node build.js'\" \"node server.js\" \"browser-sync start -p localhost:3000 --port 3001 -f 'dist/**' 'public/**' --no-notify\"",
    "start": "node server.js",
    "test": "node build.js && node --test test/",
    "test:only": "node --test test/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "fs-extra": "^11.3.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "browser-sync": "^3.0.3",
    "cheerio": "^1.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "nodemon": "^3.1.9"
  }
}
